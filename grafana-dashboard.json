{
  "title": "Student Result Prediction API",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {"id":1,"title":"HTTP requests / second","type":"timeseries","gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"sum(rate(student_api_http_requests_total[5m]))","legendFormat":"requests/s","refId":"A"}]},
    {"id":2,"title":"4xx / 5xx errors per second","type":"timeseries","gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"sum(rate(student_api_http_requests_total{status=~\"4..|5..\"}[5m]))","legendFormat":"errors/s","refId":"A"}]},
    {"id":3,"title":"Prediction attempts / second","type":"timeseries","gridPos":{"h":8,"w":12,"x":0,"y":8},"targets":[{"expr":"sum(rate(student_api_predictions_total[5m])) by (outcome)","legendFormat":"{{outcome}}","refId":"A"}]},
    {"id":4,"title":"95th percentile latency","type":"timeseries","gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(student_api_http_request_duration_seconds_bucket[5m])) by (le))","legendFormat":"p95 seconds","refId":"A"}]},
    {"id":5,"title":"Model loaded","type":"stat","gridPos":{"h":5,"w":6,"x":0,"y":16},"targets":[{"expr":"student_api_model_loaded","refId":"A"}]},
    {"id":6,"title":"Prometheus target up","type":"stat","gridPos":{"h":5,"w":6,"x":6,"y":16},"targets":[{"expr":"up{job=\"student-result-api\"}","refId":"A"}]}
  ]
}
